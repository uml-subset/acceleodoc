<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<!--
  Registers acceleodoc.cli.Main as an Eclipse IApplication so it can be
  launched via the Equinox launcher:

    eclipse -application acceleodoc.cli.app -input /path/to/src -output /path/to/doc
-->
<plugin>
    <extension
        id="acceleodoc.cli.app"
        point="org.eclipse.core.runtime.applications">
        <application>
            <run class="acceleodoc.cli.Main"/>
        </application>
    </extension>
</plugin>
